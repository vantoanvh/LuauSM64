--!strict
--!optimize 2

--[[
	Writes port/src/rom/native_calls.luau: the native function that every function address in the ROM script data stands for.

	Also writes register.txt (project root): every name the table holds, one per line, for `draft --register` (draft-register-list),
	so the module defining each name registers itself in the Registry and NativeCalls finds it.

	Usage (after native/build.sh, ROM in rom/baserom.us.z64): lute run native/tools/gen_native_calls.luau

	Design Notes
		The ROM holds N64 addresses of functions at CALL_NATIVE, CALL, CALL_LOOP and GEO_ASM style commands; the table is keyed by
		the position of the slot (rom-function-pointer-table). native_calls_scan.luau compiles the script data for 32 bits and
		reads the function of each slot from the relocations; it stops with an error where the compiled data differs from the ROM.
		The output holds positions and function names only, no ROM data.
]]

const Fs = require("@std/fs")

const ScanBlocks = require("./native_calls_scan")

const RomPath = "rom/baserom.us.z64"
const OutputPath = "port/src/rom/native_calls.luau"
const RegisterPath = "register.txt"

const Template = Fs.readFileToString("native/tools/native_calls_template.txt")

const Blocks = ScanBlocks(RomPath)
const Lines: { string } = {}
const Names: { [string]: boolean } = {}
local SlotCount = 0

table.sort(Blocks, function(Left: ScanBlocks.Block, Right: ScanBlocks.Block)
	return Left.RomStart < Right.RomStart
end)

for _, Block in Blocks do
	table.sort(Block.Slots, function(Left: ScanBlocks.Slot, Right: ScanBlocks.Slot)
		return Left.Offset < Right.Offset
	end)

	print(`{Block.Name}: {#Block.Slots} slots, ROM {string.format("0x%X", Block.RomStart)}, {Block.Size} bytes`)

	if #Block.Slots == 0 then
		continue
	end

	table.insert(Lines, `\t\t-- {Block.Name}`)
	table.insert(Lines, `\t\t[{string.format("0x%X", Block.RomStart)}] = \{`)

	for _, Slot in Block.Slots do
		table.insert(Lines, `\t\t\t[{string.format("0x%X", Slot.Offset)}] = "{Slot.Name}",`)
		Names[Slot.Name] = true
	end

	table.insert(Lines, "\t\t},")
	SlotCount += #Block.Slots
end

const Output = string.gsub(Template, "\t\t%-%- BLOCKS\n", function()
	return `{table.concat(Lines, "\n")}\n`
end)

Fs.writeStringToFile(OutputPath, Output)

const SortedNames: { string } = {}

for Name in Names do
	table.insert(SortedNames, Name)
end

table.sort(SortedNames)
Fs.writeStringToFile(RegisterPath, `# Generated by native/tools/gen_native_calls.luau: the names of port/src/rom/native_calls.luau (draft --register)\n{table.concat(SortedNames, "\n")}\n`)
print(`{SlotCount} slots, {#SortedNames} names`)
