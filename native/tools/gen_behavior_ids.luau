--!strict
--!optimize 2

--[[
	Writes port/src/rom/behavior_ids.luau: the segmented address of every behavior script (C's bhvXxx), from the native build's
	behavior_offsets.inc.

	Usage (after native/build.sh): lute run native/tools/gen_behavior_ids.luau

	Design Notes
		A bhvXxx is 0x13000000 plus the byte offset of the script inside segment 0x13 (docs/state-hash.md), as in the C
		(behavior-ids). The offsets come from the source order of data/behavior_data.c (bhv_offsets.c), so the table never depends
		on the ROM image.
]]

const fs = require("@std/fs")

const InputPath = "native/build/us/behavior_offsets.inc"
const OutputPath = "port/src/rom/behavior_ids.luau"
const SegmentBase = 0x13000000

const Lines = {
	"--!strict",
	"--!optimize 2",
	"",
	"--[[",
	"\tBehavior scripts: the segmented address of each one, 0x13000000 plus its byte offset inside segment 0x13 (docs/state-hash.md).",
	"\tsegmented_to_virtual(bhvXxx) is what an object stores in `behavior`.",
	"\tGenerated by native/tools/gen_behavior_ids.luau; do not edit.",
	"]]",
	"",
	"-- from data/behavior_data.c:ids",
	"return {",
}

for _, Line in string.split(fs.readFileToString(InputPath), "\n") do
	const Name, Offset = string.match(Line, "^OFFSET%((%w+), (0x%x+)%)")

	if Name ~= nil then
		table.insert(Lines, `\t{Name} = {string.format("0x%X", SegmentBase + (tonumber(Offset) :: number))},`)
	end
end

table.insert(Lines, "}")
table.insert(Lines, "")

fs.writeStringToFile(OutputPath, table.concat(Lines, "\n"))
print(`{#Lines - 13} ids`)
