--!strict
--!optimize 2

--[[
	Imports the local audio bundle into ReplicatedStorage.SM64Audio using temporary asset IDs.
	Run in the Studio command bar for each session and select all files inside audio/out/atlases.
]]

const HttpService = game:GetService("HttpService")
const ReplicatedStorage = game:GetService("ReplicatedStorage")
const StudioService = game:GetService("StudioService")

const ModuleName = "SM64Audio"

type Entry = { file: string }
type Manifest = { sfx: { [string]: Entry }, music: { [string]: Entry } }

const Files = StudioService:PromptImportFilesAsync({ "ogg", "json" })

assert(Files ~= nil, "no files selected")

const Lines: { string } = {}
const AudioFiles: { [string]: File } = {}
local ManifestJson: string? = nil

for _, Item in Files do
	const File = Item :: File
	const Extension = string.match(File.Name, "%.(%w+)$")

	if File.Name == "sfx-atlas.json" then
		ManifestJson = File:GetBinaryContents()
	elseif Extension == "ogg" then
		AudioFiles[File.Name] = File
	end
end

assert(ManifestJson ~= nil, "select sfx-atlas.json from audio/out/atlases")

const Manifest = HttpService:JSONDecode(ManifestJson) :: Manifest
const Imported: { [string]: boolean } = {}

for _, Group in { Manifest.sfx, Manifest.music } do
	for Key, Entry in Group do
		const Filename = Entry.file

		if not Imported[Filename] then
			const File = AudioFiles[Filename]

			assert(File ~= nil, `select {Filename} ({Key}) from audio/out/atlases`)

			Imported[Filename] = true
			table.insert(Lines, `\t[{string.format("%q", Filename)}] = {string.format("%q", File:GetTemporaryId())},`)
		end
	end
end

table.sort(Lines)

const Module = Instance.new("ModuleScript")

Module.Name = ModuleName
Module.Source = `--!strict\n--!optimize 2\n\n-- Generated by roblox/tools/ImportAudio.luau; the ids last only for the Studio session that imported the files.\n\nreturn \{\n\tIds = \{\n{table.concat(Lines, "\n")}\n\t\},\n\tManifest = {string.format("%q", ManifestJson)},\n\}\n`

const Existing = ReplicatedStorage:FindFirstChild(ModuleName)

if Existing ~= nil then
	Existing:Destroy()
end

Module.Parent = ReplicatedStorage

-- The temporary ids are discarded with their File objects, so keep them alive for the session.
shared.SM64AudioFiles = Files

print(`Imported {#Lines} sound files into ReplicatedStorage.{ModuleName}`)
