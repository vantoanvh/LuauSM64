function sounds_h.SOUND_ARG_LOAD(bank: number, soundID: number, priority: number, flags: number): number
	return bit32.bor(bit32.lshift(bank, 28), bit32.lshift(soundID, 16), bit32.lshift(priority, 8), flags, sounds_h.SOUND_STATUS_WAITING)
end

